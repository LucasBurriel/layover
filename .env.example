# Copy to .env (never committed). The key stays on the server; the browser never sees it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. anthropic | claude-code | mock. Default: auto
#   auto = anthropic if ANTHROPIC_API_KEY is set, otherwise claude-code (your Claude Code login).
# LLM_PROVIDER=auto
# NPC_MODEL=claude-opus-5-5
# COACH_MODEL=claude-opus-5-5
# PORT=8787
